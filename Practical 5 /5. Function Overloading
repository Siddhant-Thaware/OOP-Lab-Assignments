#include <iostream>
using namespace std;

int add(int a, int b)
{
    return a + b;
}

int add(int a, int b, int c)
{
    return a + b + c;
}

int main()
{
    cout << "Addition of 2 numbers = " << add(10, 20) << endl;
    cout << "Addition of 3 numbers = " << add(10, 20, 30) << endl;

    return 0;
}
