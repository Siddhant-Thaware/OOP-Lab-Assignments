#include <iostream>
using namespace std;

// Function to add two numbers
int add(int a, int b)
{
    return a + b;
}

// Function to add three numbers
int add(int a, int b, int c)
{
    return a + b + c;
}

int main()
{
    // Calling overloaded function with two arguments
    cout << "Addition of 2 numbers = " << add(10, 20) << endl;

    // Calling overloaded function with three arguments
    cout << "Addition of 3 numbers = " << add(10, 20, 30) << endl;

    return 0;
}
